#!/bin/sh
# Primary: credentials proxy endpoint (fresh token, renewable every 60s)
if [ "${FRACTA_CREDENTIALS_DEBUG:-}" = "1" ]; then
  echo "[credentials.helper] trying proxy HEAD url=https://ai-proxy.example.com region=${AWS_REGION:-ap-southeast-2}" >&2
fi

TOKEN=$(curl -sf -I -m 3 -H "X-AWS-Region: ${AWS_REGION:-ap-southeast-2}" \
  "https://ai-proxy.example.com" \
  | grep -i x-bedrock-token | sed 's/.*: //' | tr -d '\r\n')

if [ -n "$TOKEN" ]; then
  if [ "${FRACTA_CREDENTIALS_DEBUG:-}" = "1" ]; then
    echo "[credentials.helper] proxy: status=ok token_present=true" >&2
  fi
  echo "$TOKEN"
  exit 0
fi

if [ "${FRACTA_CREDENTIALS_DEBUG:-}" = "1" ]; then
  echo "[credentials.helper] proxy: status=fail token_present=false" >&2
fi

# Fallback: host-seeded token via K8s Secret mount
if [ "${FRACTA_CREDENTIALS_DEBUG:-}" = "1" ]; then
  FALLBACK_EXISTS="false"
  if [ -n "${FRACTA_AUTH_FALLBACK_FILE:-}" ] && [ -f "$FRACTA_AUTH_FALLBACK_FILE" ]; then
    FALLBACK_EXISTS="true"
  fi
  echo "[credentials.helper] fallback: file=${FRACTA_AUTH_FALLBACK_FILE:-<unset>} exists=${FALLBACK_EXISTS}" >&2
fi

if [ -n "${FRACTA_AUTH_FALLBACK_FILE:-}" ] && [ -f "$FRACTA_AUTH_FALLBACK_FILE" ]; then
  cat "$FRACTA_AUTH_FALLBACK_FILE"
  exit 0
fi

if [ "${FRACTA_CREDENTIALS_DEBUG:-}" = "1" ]; then
  echo "[credentials.helper] all sources exhausted, exiting with error" >&2
fi

exit 1
